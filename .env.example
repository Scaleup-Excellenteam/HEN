# Google Drive import — example configuration.
#
# Copy this to `.env` and fill it in to switch the feature on. `.env` is ignored
# by git; this file is the committed example and must never hold real values.
#
#   cp .env.example .env
#
# With none of these set the feature is off: the command line, the API and the
# web interface behave exactly as they do without it, nothing contacts Google,
# and no Google configuration is needed to run or test the project.
#
# `run.sh` reads `.env` if it is present. To use these outside it, export them:
#
#   set -a; source .env; set +a
#   python -m uvicorn autocomplete.web:create_app --factory --port 8000
#
# The setup these refer to is documented in
# docs/design/2026-09-01-google-drive-import-notes.md.

# ---------------------------------------------------------------- switch ---

# Off unless this is true.
HEN_DRIVE_ENABLED=false

# ------------------------------------------------- Google identification ---
#
# None of the three below is a secret. Google's own guidance treats an OAuth
# client ID and a browser API key as public configuration: both are visible to
# anyone who opens the page, and both are protected by origin restrictions set
# in the Cloud Console rather than by being hidden. This feature uses no client
# secret and no service-account key, so there is nothing here to leak.
#
# The server serves these three to the browser from /api/drive/status, so they
# are never compiled into the JavaScript bundle and changing one needs no
# rebuild.

# OAuth 2.0 Client ID, of type "Web application", with this server's origin
# listed under Authorized JavaScript origins.
HEN_DRIVE_CLIENT_ID=000000000000-example.apps.googleusercontent.com

# Browser API key. Restrict it to the Google Picker API, and add both your own
# origin and https://docs.google.com/* to its website restrictions: the Picker
# renders inside an iframe hosted on docs.google.com.
HEN_DRIVE_API_KEY=example-browser-api-key

# The Cloud project *number*, not its ID. The Picker needs it in order to grant
# this application per-file access to what the user selects under drive.file.
HEN_DRIVE_APP_ID=000000000000

# ------------------------------------------------------------- storage ----

# Where imported text and the index built over it are kept. Relative paths
# resolve against the directory holding config.yaml. Ignored by git. Deleting
# this directory removes every imported document and returns the server to
# searching the corpus alone.
HEN_DRIVE_DATA_DIR=.drive-data

# --------------------------------------------------------------- limits ---

# Most documents one import may carry.
HEN_DRIVE_MAX_FILES=10

# Largest single document, in bytes. Drive caps an export of a Google Doc at
# 10 MB, so raising this above that only affects plain-text files.
HEN_DRIVE_MAX_FILE_BYTES=10485760

# Largest total across every imported document, in bytes.
HEN_DRIVE_MAX_TOTAL_BYTES=52428800

# ------------------------------------------------------------- network ----

# Seconds one Drive request may take.
HEN_DRIVE_HTTP_TIMEOUT_SECONDS=30

# How many times a retryable Drive failure (a timeout, a 429, a 5xx) is tried
# again before the import is reported as failed.
HEN_DRIVE_HTTP_RETRIES=2
